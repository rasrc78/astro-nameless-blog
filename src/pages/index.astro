---
import Base from '../components/Base.astro'
import { getCollection } from 'astro:content'
import { SITE_CONFIG } from '../site.config'
import type { CollectionEntry } from 'astro:content'

const posts = await getCollection('blog')

function getSummary(postEntry: CollectionEntry<'blog'>, maxLength: number) {
    if (postEntry.data.description !== undefined) {
        return postEntry.data.description
    }

    if (postEntry.body !== undefined) {
        const cleanText = postEntry.body
        .replace(/^---[\s\S]*?\n---/m, '')  // remove frontmatter
        .replace(/^#+\s+\S+/gm, '')  // remove headings
        .replace(/^```[\s\S]*?\n```/gm, '')  // remove code blocks
        .replace(/!?\[.*?\]\(.*?\)/g, '')  // remove links and images
        .replace(/[\t ]+/g, ' ')  // merge spaces and tabs
        .replace(/\n+/g, '\n')  // merge line breaks
        .trim()

        return cleanText.slice(0, maxLength).trim() + '...'
    }

    return ''
}
---

<Base title={ SITE_CONFIG.title }>
    <main class="main">
        <ul class="post-wrapper">
            {posts.map(post => (
                <li class="post-inner">
                    <div class="post-meta">
                        <h2 class="post-title"><a href={`/blog/${post.id}`}>{post.data.title}</a></h2>
                        <span class="post-pubdate">{post.data.pubDate.toLocaleDateString()}</span>
                    </div>
                    <p class="post-summary">{getSummary(post, 500)}</p>
                </li>
            ))}
        </ul>
    </main>
</Base>

<style>
    .post-wrapper {
        margin: 0;
    }

    .post-inner {
        display: block;
        word-break: break-word;
    }

    .post-inner + .post-inner {
        margin-top: 2rem;
    }


    .post-meta{
        display: flex;
        flex-direction: column;
        align-items: baseline;
    }

    .post-title {
        margin-right: 1rem;
    }

    /* .post-title::after {
        content: '·';
        font-size: 1rem;
        color: var(--color-bg-400);
        margin: 0 0.5rem;
        opacity: 0.5;
    } */

    .post-pubdate {
        color: var(--color-bg-400);
    }

    .post-summary {
        white-space: pre-line;
        margin-left: 0.1rem;
    }

    @media (min-width: 500px) {
        .post-meta {
            flex-direction: row;
        }

        .post-title {
            max-width: calc(100% - 5em);
        }
    }
</style>
