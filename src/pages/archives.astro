---
import Base from "../components/Base.astro"
import { getCollection } from "astro:content"

const posts = await getCollection('blog')
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
const months = [...new Set(
    sortedPosts.map(post => JSON.stringify([post.data.pubDate.getFullYear(), post.data.pubDate.getMonth()]))
)].map(month => JSON.parse(month))
---

<Base title="Archives" isAppendTitle={ false }>
    <main class="main">
        <ul class="archive-wrapper">
            {months.map(month => (
            <li class="archive-inner">
                <span class="date">{month[0]} / {month[1] + 1}</span>
                <ul>
                    {sortedPosts.filter(post => {
                        const postDate = post.data.pubDate
                        return postDate.getFullYear() === month[0] && postDate.getMonth() === month[1]
                    }).map(post => (
                    <li class="archive">
                        <a href={"/post/" + post.id} class="archive-title">{post.data.title}</a>
                    </li>))}
                </ul>
            </li>))}
        </ul>
    </main>
</Base>

<style>
    ul {
        margin: 0;
        line-height: 1;
    }

    li {
        list-style-type: none;
        line-height: 1;
    }


    .date {
        font-weight: bold;
        font-size: 1.5em;
    }

    .archive-inner + .archive-inner {
        margin-top: 1em;
    }
    
    .archive {
        margin-left: 1.5em;
        font-size: 1.2em;
        line-height: 1.2;
    }
</style>