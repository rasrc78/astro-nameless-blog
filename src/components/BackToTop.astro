<div class="is-hide" id="rocket-botton">
    <a href="#" onclick="return false;">
        <svg class="arrow-icon" viewBox="2 2 20 20" fill="none">
            <line x1="12" y1="19" x2="12" y2="5"></line>
            <polyline points="5 12 12 5 19 12"></polyline>
        </svg>
    </a>
</div>

<style>
    #rocket-botton {
        position: sticky;
        bottom: 0.5em;
        width: 2em;
        height: 2em;
        margin-left: auto;
        margin-right: 0.5em;
        line-height: 0;
        opacity: 0.8;
        border-radius: 0.1em;
        background-color: var(--color-bg-600);
        transition: opacity 0.3s, visibility 0.3s;
    }

    #rocket-botton:hover {
        opacity: 1;
    }

    .arrow-icon {
        width: 100%;
        height: 100%;
        stroke: var(--color-bg-400);
        stroke-width: 2px;
    }

    #rocket-botton.is-hide {
        opacity: 0;
        visibility: hidden;
    }

    @media (min-width: 400px) {
        #rocket-botton {
            bottom: 2em;
            margin-right: 2em;
        }
    }
</style>

<script>
    const topBotton = document.querySelector('#rocket-botton') as HTMLElement
    let prevScrollOff = window.scrollY
    let currentScrollOff = window.scrollY
    let isScroll = false

    window.addEventListener('scroll', function() {
        if (!isScroll) {
            isScroll = true
            window.requestAnimationFrame(autoHideTopBotton)
        }
    })

    topBotton.onclick = function() {
        document.documentElement.scrollTo({
            top: 0,
            behavior: 'smooth',
        })
    }

    function autoHideTopBotton() {
        currentScrollOff = window.scrollY
        if (currentScrollOff < window.innerHeight * 2 || currentScrollOff > prevScrollOff) {
            topBotton.classList.add('is-hide')
        } else {
            topBotton.classList.remove('is-hide')
        }
        isScroll = false
        prevScrollOff = currentScrollOff
    }
</script>
