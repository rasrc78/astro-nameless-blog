---
import { SITE_CONFIG } from "../site.config";
const title = SITE_CONFIG.title
---

<header>
    <nav class="nav">
        {
        Astro.url.pathname === '/' ?
            <h1 class="site-title"><a href="/">{title}</a></h1> :
            <div class="site-title"><a href="/">{title}</a></div>
        }
        <button id="menu-toggle">
            <svg class="burger-icon" viewBox="0 0 24 24" width="32" height="32">
                <line class="line line-top" x1="3" y1="6" x2="21" y2="6" />
                <line class="line line-middle" x1="3" y1="12" x2="21" y2="12" />
                <line class="line line-bottom" x1="3" y1="18" x2="21" y2="18" />
            </svg>
        </button>
        <div class="nav-wrapper">
            <a class="nav-item" href="/">Home</a>
            <a class="nav-item" href="/archives">Archves</a>
            <a class="nav-item" href="/about">About</a>
            <a class="nav-item" href="/rss.xml">RSS</a>
        </div>
    </nav>
    <div id="nav-space"></div>
</header>

<style>
    /**
      /// nav basic style ///
    */
    nav {
        position: fixed;
        height: var(--nav-height);
        width: 100%;
        height: var(--nav-height);
        background-color: var(--color-bg-600);
        box-shadow: 0px -0.9rem 0.2rem 1rem var(--color-bg-600);
        transition: transform 0.5s;
    }

    .nav-wrapper {
        display: flex;
        flex-direction: column;
        position: absolute;
        width: 100%;
        z-index: 1;
        transform: translateY(calc(-100% - var(--nav-height)));
        transition: transform 0.5s;
    }

    .nav-item {
        flex-grow: 1;
        color: var(--color-text-500);
        line-height: var(--nav-height);
        text-align: center;
        font-weight: bold;
        background-color: var(--color-bg-600);
        transition: all 0.2s ease;
    }

    .nav-item:hover, .nav-item:focus-visible {
        color: var(--color-text-600);
        box-shadow: inset 1rem 0px 0.5rem -1rem var(--color-bg-700), inset -1rem 0px 0.5rem -1rem var(--color-bg-700);
    }

    .nav-item:active {
        color: var(--color-primary-600);
    }

    .is-hide {
        transform: translateY(-100%);
    }

    #nav-space {
        height: var(--nav-height);
    }

    /**
      /// site title (mobile only) ///
    */
    .site-title {
        line-height: var(--nav-height);
        font-size: 1rem;
        font-weight: bold;
        padding: 0;
        margin: 0 0.5em;
        max-width: calc(100% - 4em);  /* subtract the spacing and botton width */
        position: absolute;
        left: 0;
    }

    .site-title a {
        color: var(--color-text-500);
    }

    .site-title a:hover, .site-title a:focus-visible {
        color: var(--color-text-600);
    }

    /**
      /// hanburger menu ///
    */
    .nav-wrapper.is-expand {
        transform: none;
    }

    #menu-toggle {
        display: block;
        outline: none;
        border: none;
        border-radius: 0px;
        background-color: var(--color-bg-600);
        height: 100%;
        padding: 0px 0.5em;
        position: absolute;
        right: 0;
        z-index: 2;
    }

    .burger-icon .line {
        stroke: var(--color-bg-400);
        stroke-width: 2;
        transform-origin: 6px;
        transition: transform 0.5s, opacity 0.5s;
    }

    button.is-active#menu-toggle .burger-icon .line-middle {
        transform: scaleX(0);
        opacity: 0;
    }

    button.is-active#menu-toggle .burger-icon .line-top {
        transform: rotate(45deg);
    }

    button.is-active#menu-toggle .burger-icon .line-bottom {
        transform: rotate(-45deg);
    }

    /**
      /// nav for decktop ///
    */
    @media (min-width: 400px) {
        #menu-toggle {
            display: none;
        }

        .site-title {
            display: none;
        }
    
        .nav-wrapper {
            flex-direction: row;
            justify-content: center;
            transform: none;
        }

        .nav-item {
            max-width: 14em;
        }
    }
</style>

<script>
    const navbar = document.querySelector('.nav')
    const burgerMenu = document.querySelector('.nav-wrapper')
    const menuToggle = document.querySelector('#menu-toggle')
    // const navbarHeight = +window.getComputedStyle(navbar).height
    let prevScrollOff = window.scrollY
    let currentScrollOff = window.scrollY
    let isScroll = false
    let burgerMenuActive = burgerMenu?.classList.contains('is-expand')

    window.onscroll = function() {
        if (!isScroll && navbar) {
            isScroll = true
            window.requestAnimationFrame(autoHideNavbar)
        }
    }
    menuToggle?.addEventListener('click', toggleMenu)

    function autoHideNavbar() {
        currentScrollOff = window.scrollY
        if (prevScrollOff > currentScrollOff ) {
            navbar?.classList.remove('is-hide')
        } else {
            navbar?.classList.add('is-hide')
            if (burgerMenuActive) {
                toggleMenu()
            }
        }
        isScroll = false
        prevScrollOff = currentScrollOff
    }
    function toggleMenu()  {
        if (burgerMenuActive) {
            burgerMenu?.classList.remove('is-expand')
            menuToggle?.classList.remove('is-active')
            burgerMenuActive = false
        } else {
            burgerMenu?.classList.add('is-expand')
            menuToggle?.classList.add('is-active')
            burgerMenuActive = true
        }
    }
</script>