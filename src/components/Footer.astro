---
import { SITE_CONFIG } from "../site.config";
---

<footer class="footer">
    <p set:html={SITE_CONFIG.copyright} />
    <p>Powered by <a href="https://astro.build/">Astro</a></p>
</footer>

<style>
    .footer {
        display: block;
        justify-self: flex-end;
        position: relative;
        bottom: 0;
        width: 100%;
        margin-top: 4em;
        padding: 0.5em 0;
        background-color: var(--color-bg-600);
        box-shadow: 0px 0.9rem 0.2rem 1rem var(--color-bg-600);
    }

    .footer p {
        text-align: center;
    }
</style>