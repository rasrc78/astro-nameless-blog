---
import Base from "./Base.astro"
import { SITE_CONFIG } from "../site.config"

const { title, contentComponent: Content, isAppendTitle = SITE_CONFIG.titleSuffix } = Astro.props
---

<Base title={`${title}${SITE_CONFIG.titleSuffix ? ` - ${SITE_CONFIG.title}` : ''}`}>
        <main class="main">
            { isAppendTitle ? <h1>{title}</h1> : '' }
            <Content />
        </main>
</Base>

<style is:global>
    h1, h2, h3, h4, h5, h6 {
        margin-top: 1em;
        margin-bottom: 0.5em;
    }
    /**
    /// title separetor ///
    */

    h1, h2 {
        position: relative;
    }

    h1::after, h2::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 0;
        height: 1px;
        width: 100%;
        margin: 0 auto;
        border: none;
        background-color: var(--color-bg-400);
    }
</style>